# Mode penyimpanan aplikasi:
# - local  : Hanya penyimpanan browser (IndexedDB), tanpa menu/pilihan ke Database server.
# - server : Dual storage (Lokal IndexedDB + opsi simpan & sinkronisasi ke Database server).
VITE_STORAGE_MODE=local

# URL backend untuk development lokal (dipakai saat VITE_STORAGE_MODE=server).
# Proxy Vite meneruskan /api ke alamat ini.
VITE_API_TARGET=http://localhost:6000
